    "@mlain/core": "workspace:*",
    "@mlain/db": "workspace:*",
    "@mlain/emails": "workspace:*",
    "@mlain/i18n": "workspace:*",
    "@mlain/ui": "workspace:*",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-bold": "3.29.2",
    "@tiptap/extension-document": "3.29.2",
    "@tiptap/extension-hard-break": "3.29.2",
