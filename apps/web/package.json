{
  "name": "@mlain/web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "// build": "NODE_ENV se tu nastavuje výslovně, není to zbytečnost. `next build` si ho doplní jen tehdy, když není nastavené, takže když do prostředí prosákne NODE_ENV=development (typicky přes `set -a && . apps/web/.env.local`), postaví se rozbitá aplikace. Podrobný rozbor je v komentáři u kontroly v next.config.ts.",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "pnpm run test:e2e:ui && pnpm run test:e2e:golden",
    "test:e2e:ui": "playwright test",
    "test:e2e:golden": "playwright test -c playwright.golden.config.ts",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "contracts:generate": "tsx scripts/generate-openapi.ts --generated"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
