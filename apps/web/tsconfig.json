{
  "extends": "@mlain/config/tsconfig/next.json",
  "compilerOptions": {
    // `rootDir` tu SCHVÁLNĚ není a `declaration` se vypíná.
    //
    // Aplikace nikdy nic neemituje (`noEmit` ze sdíleného presetu), takže obojí
    // je tu bez užitku, ale ne bez následku: se zapnutou deklarací hlídá tsc,
    // že všechny zdroje leží pod `rootDir`, a workspace balíčky se importují
    // ZE ZDROJE, ne z buildu. Jakmile graf importů povyrostl, začalo to padat
    // na TS6059 „File packages/core/src/config/index.ts is not under rootDir",
    // tedy na chybě, která ukazuje na cizí balíček, přestože vada je v tomhle
    // souboru. Balíčky, které deklarace opravdu vydávají, si je zapínají samy.
    "declaration": false,
    "declarationMap": false,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    // Týž důvod, jaký je zapsaný v `packages/core/tsconfig.json`.
    // `@mlain/emails` se vystavuje jako ZDROJOVÉ .ts a .tsx bez buildu, takže od
    // chvíle, kdy aplikace mountuje trasy šablon, vstupuje do programu tsc celý
    // emitter. Ten deklaruje `html-to-text` (od verze 9 bez vlastních typů)
    // ambientním souborem, který se do programu dostane JEN přes `include`.
    // Bez tohohle řádku spadne typecheck aplikace na TS7016
    // v `packages/emails/src/text/emit.ts`, přestože `apps/web`
    // `html-to-text` nikdy nezmíní.
    "../../packages/emails/src/external/*.d.ts"
  ]
}
