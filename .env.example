# Ukázková konfigurace pro docker/compose.yml.
# Zkopírujte na .env a vyplňte. Soubor .env do gitu NEPATŘÍ.

# --- Povinné -----------------------------------------------------------------
# Absolutní URL instalace, bez koncového lomítka.
APP_URL=https://mail.example.cz

# Klíč pro šifrování a podpisy. Vygenerujte příkazem:
#   docker run --rm ghcr.io/nc-mill/mlain:1.0.0 mlain genkey
# Tvar je <key_id>:<base64url>, po dekódování přesně 32 bajtů.
# Klíč si zálohujte MIMO zálohy aplikace: mlain backup ho záměrně neobsahuje.
SECRET_KEY=

# Heslo role mlain_migrator v přibaleném Postgresu.
POSTGRES_PASSWORD=zmente-me

# --- Volitelné ---------------------------------------------------------------
# Port na hostiteli.
APP_PORT=3000

# Výchozí jazyk rozhraní.
DEFAULT_LOCALE=cs

# trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Doména, ze které sender staví odkazy /t/o/, /t/c/ a /u/ (otevření, prokliky
# a odhlášení). Prázdná hodnota je v pořádku jen v compose: entrypoint si ji
# odvodí z APP_URL a doplní schéma.
#
# MIMO COMPOSE JE POVINNÁ. Odesílací služba v Go bez ní NENASTARTUJE a skončí
# s kódem 78; nemá výchozí hodnotu schválně, protože e-mail s rozbitým odkazem
# na odhlášení je horší než e-mail, který neodejde.
#
# POZOR NA TVAR, každá strana ji čte jinak:
#   - Go (apps/sender) chce ABSOLUTNÍ URL se schématem: https://mail.example.cz
#   - TypeScript si ji odvozuje z APP_URL jako HOLÝ HOST: mail.example.cz
# Holý host senderu nestačí a odmítne ho s hláškou, že to není absolutní URL.
# Když ji vyplňujete ručně, pište ji ve tvaru pro Go, tedy se schématem.
# TRACKING_DOMAIN=https://mail.example.cz

# Zdravotní port odesílací služby. Cesty jsou /healthz (liveness) a /readyz
# (readiness), NE /health. Při MODE=all se nesmí krýt s portem webu (3000)
# ani workeru (3001).
# SENDER_HEALTH_PORT=3002

# Starší pokolení klíče po rotaci, oddělená čárkou, ve tvaru <key_id>:<base64url>.
# NIKDY se nevyprazdňuje: bez starých pokolení přestanou platit otisky smazaných
# adres v suppression listu a smazaný člověk se vrátí prvním dalším importem.
SECRET_KEY_PREVIOUS=

# VYPÍNAČ BRZD PŘIHLAŠOVÁNÍ, VÝHRADNĚ PRO VÝVOJ. DO PRODUKCE NEPATŘÍ.
#
# Brzdy proti hádání hesel jsou nastavené na útočníka, ne na člověka, který si
# aplikaci ručně zkouší: pravidlo login_ip_email pustí 5 pokusů za 300 sekund,
# po 10 neúspěších se účet zamkne na 15 minut a každá odpověď má časovou
# podlahu 250 ms. Při ručním testování se na to čeká zbytečně dlouho.
#
# Hodnota true vypne PRÁVĚ TOHLE TROJÍ a nic víc. Heslo se ověřuje dál, žádná
# jiná část přihlášení se nemění. Limity API klíčů, importu ani odesílání se
# nevypínají.
#
# Výchozí hodnota je false, tedy plná ochrana. Chybějící proměnná se chová
# přesně jako false. S NODE_ENV=production a hodnotou true aplikace NENASTARTUJE
# a skončí s chybou konfigurace (exit 78); je to schválně, aby se vypnutá
# ochrana nedala do produkce protáhnout omylem. Když je zapnutá, píše se o tom
# varování do logu při každém startu.
# LOGIN_THROTTLING_DISABLED=true

# Externí Postgres: vyplňte a nespouštějte profil bundled.
# DATABASE_URL=postgres://mlain_app:heslo@db.example.cz:5432/mlain
# DATABASE_URL_MIGRATOR=postgres://mlain_migrator:heslo@db.example.cz:5432/mlain
# DATABASE_URL_SENDER=postgres://mlain_sender:heslo@db.example.cz:5432/mlain

# Připojení pro systémové úlohy, které čtou NAPŘÍČ projekty: plánovač kampaní,
# hlídač běžících, obnova po vyčerpané kvótě, rekonciliace outboxu, rekontrola
# odesílacích domén a úklid projektů po uplynutí lhůty na obnovu.
#
# Role mlain_maintenance má výjimku z izolace projektů, ale jen na tři tabulky
# (workspaces, campaigns, sender_domains) a jediné právo zápisu (smazání už
# měkce smazaného projektu). Vynucují to politiky maintenance_* z migrace 0009.
#
# Proměnná je VOLITELNÁ. Bez ní instalace naběhne a běžný provoz včetně
# okamžitého odeslání kampaně funguje; nepoběží jen ty vyjmenované úlohy
# a každá při prvním tiku vysvětlí, co chybí. Prakticky to znamená, že se
# NAPLÁNOVANÁ kampaň neodešle, tak si to nastavte.
# DATABASE_URL_MAINTENANCE=postgres://mlain_maintenance:heslo@db.example.cz:5432/mlain

# Připojení pro výmaz osobních údajů podle článku 17 GDPR (role mlain_gdpr).
#
# Tabulka consents je append only: aplikační role na ni právo DELETE nemá ani
# mít nesmí, jinak by šlo souhlas přepsat běžnou operací. Souhlasy proto maže
# vyhrazená role a tohle je jediné místo, kde se používá.
#
# Role výjimku z izolace projektů NEMÁ: maže výhradně souhlasy jednoho kontaktu
# v jednom projektu, protože consents má politiku ws_isolation jako každá jiná
# tabulka s osobními údaji.
#
# Proměnná je VOLITELNÁ jen technicky. Bez ní instalace naběhne, ale VÝMAZ
# PODLE ČLÁNKU 17 NEDOBĚHNE: anonymizace kontaktu, tedy výchozí režim, se zruší
# celá a žádost subjektu zůstane nevyřízená. U produktu na rozesílání e-mailů
# je to zákonná povinnost se lhůtou, tak si to nastavte.
# DATABASE_URL_GDPR=postgres://mlain_gdpr:heslo@db.example.cz:5432/mlain
