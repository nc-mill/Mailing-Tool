{
  "extends": "@mlain/config/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    // composite zapisuje tsconfig.tsbuildinfo vedle tsconfig.json a .gitignore
    // ho nezná, takže by se build artefakt dostal do commitu. dist/ ignorovaný je.
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules", "test"]
}
